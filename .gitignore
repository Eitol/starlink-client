.idea
venv/

# Python build and runtime artefacts, produced by `pip install -e` and by any
# use of the library.
__pycache__/
*.egg-info/

# Account session cookies written by the file-system cookie store, which the
# examples point at this directory. Never commit these.
tmp_cookies/

# Generated by buf for languages this repo does not ship. `make generate`
# recreates them on demand.
libs/node/
libs/kotlin/
libs/java/
